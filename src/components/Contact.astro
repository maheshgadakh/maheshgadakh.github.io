---
// Contact.astro
---

<section id="contact" class="contact-section" aria-label="Contact Mahesh Gadakh">
  <div class="container">
    <div class="contact-wrapper">
      <div class="section-eyebrow">06 / CONTACT</div>
      
      <h2 class="contact-headline">
        Have a project in mind?
      </h2>

      <p class="contact-subtext">
        Let's talk about CDP, marketing technology or data engineering.
      </p>

      <div class="contact-actions">
        <a 
          href="mailto:gadakhm122@gmail.com" 
          class="btn-primary" 
          id="cta-get-in-touch"
          aria-label="Send email to Mahesh Gadakh"
        >
          <span>GET IN TOUCH</span>
          <span class="cta-arrow" aria-hidden="true">↗</span>
        </a>

        <a 
          href="https://www.linkedin.com/in/mahesh-gadakh-13366219b/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="linkedin-btn"
          aria-label="View Mahesh Gadakh LinkedIn Profile"
        >
          <svg class="linkedin-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
            <rect x="2" y="9" width="4" height="12"/>
            <circle cx="4" cy="4" r="2"/>
          </svg>
          <span>Connect on LinkedIn</span>
          <span class="cta-arrow" aria-hidden="true">↗</span>
        </a>
      </div>

      <!-- Quick Contact Info Grid -->
      <div class="contact-details-grid">
        <div class="contact-card">
          <span class="card-eyebrow">DIRECT EMAIL</span>
          <div class="email-card-row">
            <a href="mailto:gadakhm122@gmail.com" class="card-value">
              gadakhm122@gmail.com
            </a>
            <button
              class="copy-email-button"
              type="button"
              data-copy-email="gadakhm122@gmail.com"
              aria-label="Copy email address"
              aria-describedby="copy-email-status"
              title="Copy email address"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="8" y="8" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.7"/>
                <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" stroke="currentColor" stroke-width="1.7"/>
              </svg>
            </button>
          </div>
          <span id="copy-email-status" class="copy-email-status" role="status" aria-live="polite"></span>
        </div>

        <div class="contact-card">
          <span class="card-eyebrow">LINKEDIN PROFILE</span>
          <a href="https://www.linkedin.com/in/mahesh-gadakh-13366219b/" target="_blank" rel="noopener noreferrer" class="card-value">
            linkedin.com/in/mahesh-gadakh
          </a>
        </div>

        <div class="contact-card">
          <span class="card-eyebrow">AVAILABILITY</span>
          <span class="card-value status-online">
            <span class="status-dot"></span>
            Available for Consulting & Enterprise Solutions
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyEmailButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const copyEmailStatus = document.getElementById('copy-email-status');

  copyEmailButton?.addEventListener('click', async () => {
    const email = copyEmailButton.dataset.copyEmail;
    if (!email || !navigator.clipboard) {
      if (copyEmailStatus) copyEmailStatus.textContent = 'Clipboard access is unavailable. Select and copy the email address above.';
      return;
    }

    try {
      await navigator.clipboard.writeText(email);
      if (copyEmailStatus) copyEmailStatus.textContent = 'Email address copied.';
    } catch (error) {
      console.error('Could not copy the email address to the clipboard.', error);
      if (copyEmailStatus) copyEmailStatus.textContent = 'Copy failed. Select and copy the email address above.';
    }
  });
</script>

<style>
  .contact-section {
    position: relative;
    background-color: var(--color-bg);
    padding: var(--section-spacing-y) 0;
    border-top: 1px solid var(--color-border);
    overflow: hidden;
  }

  /* Subtle Red Radial Accent Background */
  .contact-section::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 350px;
    background: radial-gradient(circle, rgba(241, 10, 18, 0.08) 0%, rgba(244, 242, 239, 0) 70%);
    pointer-events: none;
    z-index: 1;
  }

  .contact-wrapper {
    position: relative;
    z-index: 2;
    max-width: 900px;
  }

  .contact-headline {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin-bottom: 1.5rem;
  }

  .contact-subtext {
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: 3.5rem;
    max-width: 650px;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 5rem;
  }

  .cta-arrow {
    display: inline-block;
    transition: transform var(--transition-fast);
  }

  .btn-primary:hover .cta-arrow,
  .linkedin-btn:hover .cta-arrow {
    transform: translate(2px, -2px);
  }

  .linkedin-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 1.1rem 2rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    color: var(--color-text-primary);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 2px;
    transition: background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
  }

  .linkedin-btn:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
  }

  .linkedin-icon {
    color: var(--color-red);
  }

  /* Details Grid */
  .contact-details-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .contact-details-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .email-card-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 100%;
  }

  .email-card-row .card-value {
    min-width: 0;
  }

  .copy-email-button {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    color: var(--color-text-muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .copy-email-button:hover,
  .copy-email-button:focus-visible {
    color: var(--color-red-text);
    background-color: var(--color-surface);
    border-color: var(--color-border);
  }

  .copy-email-status {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .copy-email-status:empty {
    display: none;
  }

  .card-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-red-text);
    text-transform: uppercase;
  }

  .card-value {
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    font-weight: 500;
    word-break: break-all;
    transition: color var(--transition-fast);
  }

  a.card-value:hover {
    color: var(--color-red-text);
  }

  .status-online {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    word-break: normal;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    background-color: #10B981;
    border-radius: 50%;
    box-shadow: 0 0 8px #10B981;
    flex-shrink: 0;
    animation: availability-pulse 2.4s ease-in-out infinite;
  }

  @keyframes availability-pulse {
    0%, 100% {
      opacity: 1;
      box-shadow: 0 0 8px #10B981;
    }
    50% {
      opacity: 0.65;
      box-shadow: 0 0 2px #10B981;
    }
  }
</style>
