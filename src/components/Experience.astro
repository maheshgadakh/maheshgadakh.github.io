---
// Experience.astro
const experiences = [
  {
    company: "Xpheno Pvt Ltd",
    role: "Customer Research Data Architect",
    period: "September 2026 – Present",
    location: "Pune, India",
    isCurrent: true,
    summary: [
      "Design scalable data architecture connecting CRM platforms with cloud data warehouses, data hubs, and Oracle systems to support a unified customer view.",
      "Define enterprise data models and lead end-to-end integration strategies, including batch, API-based, and event-driven patterns.",
      "Guide ETL/ELT pipeline design and establish data governance, quality, and security standards.",
      "Partner with business stakeholders and engineering teams to translate requirements into solutions, support MDM, and address complex integration challenges."
    ]
  },
  {
    company: "Chimera Technologies Pvt Ltd",
    role: "Consultant | Lead CDP Engineer",
    period: "April 2026 – August 2026",
    location: "Bengaluru, India",
    isCurrent: false,
    summary: [
      "Lead an enterprise Treasure Data CDP implementation for a global pharmaceutical client, partnering with business and marketing stakeholders to shape scalable solutions.",
      "Drive Customer 360 and identity resolution across online and offline data sources.",
      "Define audience segmentation, customer data models, governance standards, and campaign activation strategies.",
      "Recommend data-led approaches to strengthen customer acquisition, retention, engagement, and campaign outcomes."
    ]
  },
  {
    company: "Infocepts Pvt Ltd",
    role: "Senior Executive | Senior CDP Engineer",
    period: "October 2024 – March 2026",
    location: "Pune, India",
    isCurrent: false,
    summary: [
      "Integrated multi-source marketing data into Treasure Data CDP and supported unified customer profiles.",
      "Built audience segmentation and activation workflows across Salesforce Marketing Cloud, Pipedrive, and Oracle Eloqua.",
      "Automated workflows with SQL and Python, supported campaign analysis, and partnered with stakeholders on segmentation and activation requirements.",
      "Used Git, GitHub, CI/CD, and Agile practices to support collaborative development and deployment."
    ]
  },
  {
    company: "Course5 Intelligence Pvt Ltd",
    role: "Senior Analyst | Senior Data Engineer",
    period: "January 2022 – October 2024",
    location: "Mumbai, India",
    isCurrent: false,
    summary: [
      "Designed and optimized Python and SQL ETL pipelines supporting CDP solutions, reducing processing time from 6–7 hours to approximately 2.5 hours.",
      "Integrated data from Klaviyo, Amazon Marketing Cloud, Salesforce Marketing Cloud, and Amazon DSP into Treasure Data CDP; developed customer data models for segmentation and analytics.",
      "Automated cloud data workflows using AWS S3/EC2 and Azure Data Factory/Data Lake Storage.",
      "Partnered with data science teams on predictive analytics and supported customer journey, campaign measurement, and attribution use cases."
    ]
  }
];
---

<section id="experience" class="experience-section" aria-label="Career Experience">
  <div class="container">
    <div class="section-eyebrow">04 / EXPERIENCE</div>
    <h2 class="section-heading">Professional experience.</h2>

    <div class="timeline">
      {experiences.map((item) => (
        <article class={`timeline-item ${item.isCurrent ? 'current' : ''}`}>
          <div class="timeline-period-col">
            <span class="period-text">{item.period}</span>
            {item.isCurrent && (
              <span class="current-badge">
                <span class="pulse-dot"></span>
                <span>PRESENT</span>
              </span>
            )}
          </div>

          <div class="timeline-node" aria-hidden="true">
            <div class="node-dot"></div>
          </div>

          <div class="timeline-content-col">
            <div class="company-header">
              <h3 class="company-name">{item.company}</h3>
              {item.location && <span class="role-location">{item.location}</span>}
            </div>
            <div class="role-title">{item.role}</div>
            <ul class="role-summary">
              {item.summary.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-section {
    position: relative;
    background-color: var(--color-bg);
    padding: var(--section-spacing-y) 0;
    border-top: 1px solid var(--color-border);
  }

  .timeline {
    position: relative;
    margin-top: 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    position: relative;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 860px) {
    .timeline-item {
      grid-template-columns: 240px 40px 1fr;
      gap: 2rem;
      align-items: baseline;
      padding-bottom: 3rem;
    }
  }

  /* Period Column */
  .timeline-period-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .period-text {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    letter-spacing: 0.04em;
  }

  .current-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color-red);
    background-color: rgba(241, 10, 18, 0.08);
    border: 1px solid var(--color-border-red);
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    width: fit-content;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-red);
    box-shadow: 0 0 8px var(--color-red);
  }

  /* Timeline Node */
  .timeline-node {
    display: none;
  }

  @media (min-width: 860px) {
    .timeline-node {
      display: flex;
      justify-content: center;
      position: relative;
      height: 100%;
    }

    .node-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background-color: var(--color-surface);
      border: 2px solid var(--color-border-hover);
      margin-top: 0.4rem;
      transition: background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
    }

    .timeline-item.current .node-dot {
      background-color: var(--color-red);
      border-color: var(--color-red);
      box-shadow: 0 0 12px var(--color-red);
    }

    .timeline-item:hover .node-dot {
      border-color: var(--color-red);
      transform: scale(1.3);
    }
  }

  /* Content Column */
  .timeline-content-col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .company-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .company-name {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 2.75vw, 2.75rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .timeline-item:hover .company-name {
    color: var(--color-red);
  }

  .role-location {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .role-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: #FFFFFF;
    margin-bottom: 0.5rem;
  }

  .role-summary {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 680px;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .role-summary li + li {
    margin-top: 0.5rem;
  }
</style>
